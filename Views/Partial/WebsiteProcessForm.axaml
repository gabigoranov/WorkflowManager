<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:binding="clr-namespace:WorkflowManager.ViewModels.Binding"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WorkflowManager.Views.Partial.WebsiteProcessForm"
             x:DataType="binding:WebsiteProcessBindingModel">
    <StackPanel Spacing="{DynamicResource Spacing.Sm}">
        <TextBlock Text="Website Configuration" Classes="SecondaryText" FontWeight="Bold"/>
        
        <StackPanel Spacing="2">
            <TextBlock Text="Website / URL" FontSize="12" Classes="SecondaryText"/>
            <TextBox Text="{Binding URL, UpdateSourceTrigger=LostFocus}" 
                     Watermark="e.g. https://youtube.com" 
                     AcceptsReturn="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
